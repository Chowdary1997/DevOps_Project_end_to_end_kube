NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=http://localhost:8080
TRUST_PROXY=1
DOUBLE_OPT_IN=1
PRIVACY_POLICY_VERSION=2026-10-01
LAUNCH_AT=2026-12-01T09:00:00Z

# PostgreSQL. docker-compose builds DATABASE_URL from these values.
POSTGRES_DB=coming_soon
POSTGRES_USER=coming_soon
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Generate each secret with: openssl rand -hex 32
IP_HASH_SALT=replace-with-64-hex-characters
ADMIN_TOKEN=replace-with-64-hex-characters
WEBHOOK_SECRET=replace-with-64-hex-characters

SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Your Company <no-reply@example.com>"
